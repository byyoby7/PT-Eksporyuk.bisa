
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101c2c">
  <meta name="description" content="PT Ekspor Yuk connects Indonesian commodities with international markets. Explore fishmeal, pellets, and coffee.">
  <title>PT Ekspor Yuk | Indonesian Commodity Export</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #101c2c;
      --navy-light: #192a40;
      --gold: #c8a66a;
      --cream: #f6f3ed;
      --white: #ffffff;
      --muted: #a9b5c4;
      --ink: #202b37;
      --line: rgba(255,255,255,.13);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; scroll-padding-top: 85px; }

    body {
      font-family: "DM Sans", sans-serif;
      color: var(--ink);
      background: var(--cream);
      line-height: 1.7;
    }

    a { text-decoration: none; color: inherit; }
    img { display: block; width: 100%; object-fit: cover; }
    button { font: inherit; }

    .container {
      width: min(1160px, 88%);
      margin: auto;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 3px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 30px;
      height: 1px;
      background: currentColor;
    }

    h1, h2, h3 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 500;
      line-height: 1.2;
    }

    h2 { font-size: clamp(32px, 4vw, 48px); }

    .section-heading {
      max-width: 650px;
      margin-bottom: 44px;
    }

    .section-heading .eyebrow { margin-bottom: 18px; }

    .section-heading h2 { margin-bottom: 16px; }

    .section-heading p { color: #687482; }

    /* Navigation */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(16,28,44,.97);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(15px);
    }

    .nav-inner {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: white;
      flex-shrink: 0;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 43px;
      height: 43px;
      border: 1px solid var(--gold);
      color: var(--gold);
      font-family: Georgia, serif;
      font-size: 24px;
    }

    .brand-name {
      display: block;
      font-weight: 700;
      font-size: 17px;
      letter-spacing: 1px;
    }

    .brand-caption {
      display: block;
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
      color: #e2e7ed;
      font-size: 12px;
    }

    .nav-links a:hover { color: var(--gold); }

    .nav-cta, .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 20px;
      font-size: 12px;
      font-weight: 700;
      transition: .25s ease;
    }

    .nav-cta, .btn-gold {
      background: var(--gold);
      color: var(--navy);
    }

    .nav-cta:hover, .btn-gold:hover {
      background: #e1c38e;
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      border: 1px solid var(--line);
      background: transparent;
      color: white;
      padding: 8px 12px;
      cursor: pointer;
    }

    /* Hero */

    .hero {
      position: relative;
      overflow: hidden;
      min-height: 650px;
      display: flex;
      align-items: center;
      color: white;
      background: var(--navy);
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: .38;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg,
        rgba(10,23,38,.98) 0%,
        rgba(10,23,38,.86) 45%,
        rgba(10,23,38,.28) 100%);
    }

    .hero-content {
      position: relative;
      z-index: 1;
      padding-top: 100px;
      padding-bottom: 100px;
      max-width: 780px;
      animation: appear .9s ease both;
    }

    .hero .eyebrow { margin-bottom: 26px; }

    .hero h1 {
      font-size: clamp(46px, 7vw, 82px);
      letter-spacing: -1.5px;
      margin-bottom: 25px;
    }

    .hero h1 span { color: var(--gold); }

    .hero-description {
      color: #d0d8e2;
      max-width: 560px;
      font-size: 15px;
      margin-bottom: 32px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .btn-outline {
      border: 1px solid rgba(255,255,255,.45);
      color: white;
    }

    .btn-outline:hover { border-color: var(--gold); color: var(--gold); }

    .hero-note {
      margin-top: 64px;
      padding-top: 23px;
      border-top: 1px solid var(--line);
      color: #c5cfdb;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* Introduction strip */

    .intro-strip {
      background: var(--gold);
      color: var(--navy);
      padding: 22px 0;
    }

    .strip-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .strip-inner span {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* About */

    .about {
      padding: 110px 0;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 75px;
      align-items: center;
    }

    .about-visual {
      position: relative;
      min-height: 430px;
    }

    .about-visual img {
      height: 430px;
      border-radius: 3px;
    }

    .visual-caption {
      position: absolute;
      bottom: -22px;
      right: -18px;
      background: var(--navy);
      color: white;
      padding: 23px 28px;
      max-width: 230px;
      border-bottom: 3px solid var(--gold);
    }

    .visual-caption strong {
      display: block;
      color: var(--gold);
      font-family: Georgia, serif;
      font-size: 24px;
      margin-bottom: 5px;
    }

    .visual-caption span { font-size: 11px; color: #d0d8e2; }

    .about-copy .eyebrow { margin-bottom: 20px; }

    .about-copy h2 { margin-bottom: 23px; }

    .about-copy p {
      color: #667382;
      font-size: 14px;
      margin-bottom: 16px;
    }

    .text-link {
      display: inline-flex;
      gap: 10px;
      color: #8a6b36;
      font-size: 12px;
      font-weight: 700;
      margin-top: 12px;
    }

    /* Products */

    .products {
      padding: 105px 0;
      background: white;
    }

    .products .section-heading { margin-bottom: 42px; }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .product-card {
      border: 1px solid #e7e5df;
      background: white;
      transition: transform .3s, box-shadow .3s;
    }

    .product-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 18px 40px rgba(16,28,44,.09);
    }

    .product-image {
      position: relative;
      height: 260px;
      overflow: hidden;
      background: #e6e2d9;
    }

    .product-image img {
      height: 100%;
      transition: transform .5s;
    }

    .product-card:hover .product-image img { transform: scale(1.05); }

    .product-number {
      position: absolute;
      top: 16px;
      left: 16px;
      background: var(--gold);
      color: var(--navy);
      padding: 5px 10px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .product-copy { padding: 27px 25px 30px; }

    .product-copy h3 {
      font-size: 26px;
      margin-bottom: 12px;
    }

    .product-copy p {
      font-size: 13px;
      color: #6b7682;
      min-height: 66px;
    }

    .product-tag {
      display: inline-block;
      margin-top: 20px;
      padding-top: 15px;
      width: 100%;
      border-top: 1px solid #e9e6df;
      font-size: 10px;
      color: #8a6b36;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 700;
    }

    /* Values */

    .values {
      padding: 100px 0;
      background: var(--navy);
      color: white;
    }

    .values .section-heading p { color: var(--muted); }

    .value-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 35px;
    }

    .value-card {
      padding-top: 25px;
      border-top: 1px solid rgba(255,255,255,.2);
    }

    .value-icon {
      color: var(--gold);
      font-size: 24px;
      margin-bottom: 18px;
    }

    .value-card h3 { font-size: 23px; margin-bottom: 13px; }

    .value-card p { color: var(--muted); font-size: 13px; }

    /* Process */

    .process { padding: 105px 0; }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
      margin-top: 42px;
    }

    .process-step {
      border-top: 2px solid #d7c39d;
      padding-top: 20px;
    }

    .step-no {
      color: #a27d40;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .process-step h3 { font-size: 21px; margin: 14px 0 10px; }

    .process-step p { color: #697482; font-size: 12px; }

    /* Contact */

    .contact {
      padding: 95px 0;
      background: #eae5da;
    }

    .contact-box {
      background: var(--navy);
      color: white;
      padding: clamp(30px, 6vw, 70px);
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      align-items: center;
      gap: 50px;
    }

    .contact-box .eyebrow { margin-bottom: 18px; }

    .contact-box h2 { margin-bottom: 18px; }

    .contact-box p { color: var(--muted); font-size: 13px; }

    .contact-details {
      border-left: 1px solid var(--line);
      padding-left: 35px;
    }

    .contact-item { margin: 15px 0; }

    .contact-item span {
      display: block;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 10px;
      margin-bottom: 4px;
    }

    .contact-item a, .contact-item strong {
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    /* Footer */

    footer {
      background: #0b1421;
      color: #aab5c3;
      padding: 30px 0;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-inner p { font-size: 11px; }

    .footer-links { display: flex; gap: 20px; font-size: 11px; }

    .footer-links a:hover { color: var(--gold); }

    @keyframes appear {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 900px) {
      .nav-links { gap: 14px; }
      .nav-cta { display: none; }
      .about-grid { gap: 45px; }
      .product-image { height: 210px; }
      .product-copy { padding: 22px 18px; }
      .process-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 680px) {
      .nav-inner { min-height: 72px; }
      .brand-name { font-size: 15px; }
      .brand-mark { width: 38px; height: 38px; }
      .menu-toggle { display: block; }
      .nav-links {
        display: none;
        position: absolute;
        top: 71px;
        left: 0;
        right: 0;
        padding: 20px 6%;
        background: var(--navy);
        border-bottom: 1px solid var(--line);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }
      .nav-links.open { display: flex; }
      .nav-links a { padding: 12px 0; }
      .hero { min-height: 610px; }
      .hero-content { padding-top: 80px; padding-bottom: 70px; }
      .hero h1 { font-size: 48px; }
      .hero-note { margin-top: 42px; }
      .strip-inner { justify-content: flex-start; gap: 12px 24px; }
      .about, .products, .values, .process { padding: 75px 0; }
      .about-grid { grid-template-columns: 1fr; gap: 55px; }
      .about-visual, .about-visual img { min-height: 320px; height: 320px; }
      .visual-caption { right: -5px; bottom: -20px; }
      .product-grid, .value-grid { grid-template-columns: 1fr; }
      .product-image { height: 270px; }
      .product-copy p { min-height: 0; }
      .value-grid { gap: 30px; }
      .contact { padding: 65px 0; }
      .contact-box { grid-template-columns: 1fr; gap: 28px; }
      .contact-details { border-left: 0; border-top: 1px solid var(--line); padding: 20px 0 0; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <header class="navbar">
    <div class="container nav-inner">
      <a class="brand" href="#home" aria-label="PT Ekspor Yuk home">
        <span class="brand-mark">E</span>
        <span>
          <span class="brand-name">EKSPOR YUK</span>
          <span class="brand-caption">Indonesian Commodity Trading</span>
        </span>
      </a>

      <button class="menu-toggle" id="menuToggle"
        aria-label="Open navigation menu" aria-expanded="false">☰</button>

      <nav class="nav-links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#about">About Us</a>
        <a href="#products">Our Products</a>
        <a href="#services">Our Approach</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="nav-cta" href="#contact">Discuss Business ↗</a>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <img class="hero-bg"
        src="https://images.unsplash.com/photo-1494412519320-aa613dfb7738?auto=format&fit=crop&w=2000&q=85"
        alt="" fetchpriority="high">
      <div class="hero-overlay"></div>

      <div class="container hero-content">
        <div class="eyebrow">Indonesian Commodities · Global Opportunities</div>
        <h1>Local Origins.<br>Global <span>Horizons.</span></h1>
        <p class="hero-description">
          Connecting Indonesian commodity potential with international
          market opportunities through trusted partnerships, clear
          communication, and a commitment to long-term business relationships.
        </p>
        <div class="hero-actions">
          <a href="#products" class="btn btn-gold">Explore Our Products ↗</a>
          <a href="#about" class="btn btn-outline">Discover Our Company</a>
        </div>
        <div class="hero-note">
          Fishmeal &nbsp; / &nbsp; Pellets &nbsp; / &nbsp; Coffee
        </div>
      </div>
    </section>

    <div class="intro-strip">
      <div class="container strip-inner">
        <span>Indonesian Product Potential</span>
        <span>International Trade</span>
        <span>Long-Term Partnerships</span>
      </div>
    </div>

    <section class="about" id="about">
      <div class="container about-grid">
        <div class="about-visual">
          <img
            src="https://greenbeanethiopia.com/assets/ethiopian-coffee-export-warehouse-CmzH576s.jpg"
            alt="Coffee beans prepared for export"
            loading="lazy">
          <div class="visual-caption">
            <strong>Indonesia</strong>
            <span>A source of diverse commodity opportunities.</span>
          </div>
        </div>

        <div class="about-copy">
          <div class="eyebrow">About PT Ekspor Yuk</div>
          <h2>Bringing Indonesian Products Closer to the World.</h2>
          <p>
            PT Ekspor Yuk is developing its presence in commodity trading
            with a focus on fishmeal for animal feed, pellets, and coffee.
            We aim to build productive connections between Indonesian
            suppliers and international buyers.
          </p>
          <p>
            Our approach is centered on understanding buyer requirements,
            communicating product information clearly, and exploring
            practical opportunities for mutually beneficial trade.
          </p>
          <a href="#contact" class="text-link">Let's explore opportunities together ↗</a>
        </div>
      </div>
    </section>

    <section class="products" id="products">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow">Our Commodities</div>
          <h2>Products with Global Potential.</h2>
          <p>
            Explore our key commodity categories. Product specifications,
            origin, packaging, and availability can be discussed according
            to actual supply and buyer requirements.
          </p>
        </div>

        <div class="product-grid">
          <article class="product-card">
            <div class="product-image">
              <img
                src="https://www.feedrawmaterial.com/photo/ps154172376-65_min_pure_fish_meal_for_fish_feed_in_poultry.jpg"
                alt="Fishmeal powder for animal feed"
                loading="lazy">
              <span class="product-number">01 / FEED INGREDIENT</span>
            </div>
            <div class="product-copy">
              <h3>Fishmeal</h3>
              <p>
                Fish-derived meal used as a protein ingredient in animal
                feed formulations, including aquaculture and livestock
                feed, subject to product specifications.
              </p>
              <div class="product-tag">Animal Feed · Feed Ingredients</div>
            </div>
          </article>

          <article class="product-card">
            <div class="product-image">
              <img
                src="https://www.biomassfuel.co.jp/cms/biomassfuel/article/onsite/images/20210121_01.jpg"
                alt="Pellet commodity stored in bulk"
                loading="lazy">
              <span class="product-number">02 / PELLETS</span>
            </div>
            <div class="product-copy">
              <h3>Pellets</h3>
              <p>
                Pellet products for potential industrial or commercial
                applications. Product type, material, grade, and intended
                use are confirmed based on buyer requirements.
              </p>
              <div class="product-tag">Pellet Products · Specifications Upon Request</div>
            </div>
          </article>

          <article class="product-card">
            <div class="product-image">
              <img
                src="https://greenbeanethiopia.com/assets/ethiopian-coffee-export-warehouse-CmzH576s.jpg"
                alt="Coffee beans in export sacks"
                loading="lazy">
              <span class="product-number">03 / AGRICULTURAL COMMODITY</span>
            </div>
            <div class="product-copy">
              <h3>Coffee</h3>
              <p>
                Coffee sourcing opportunities for buyers seeking green
                coffee beans or other available product forms, subject
                to origin, grade, and supply confirmation.
              </p>
              <div class="product-tag">Coffee Beans · Origin and Grade Upon Request</div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="values" id="services">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow">Our Approach</div>
          <h2>Built on Clarity. Driven by Partnership.</h2>
          <p>
            We aim to make early-stage commodity discussions clear,
            practical, and focused on the needs of both parties.
          </p>
        </div>

        <div class="value-grid">
          <article class="value-card">
            <div class="value-icon">◇</div>
            <h3>Product Transparency</h3>
            <p>
              Discuss specifications, product forms, origin, packaging,
              and supporting documentation before proceeding with an order.
            </p>
          </article>
          <article class="value-card">
            <div class="value-icon">↔</div>
            <h3>Buyer Collaboration</h3>
            <p>
              Understand purchasing requirements and explore suitable
              supplier and product options together.
            </p>
          </article>
          <article class="value-card">
            <div class="value-icon">◎</div>
            <h3>Trade Coordination</h3>
            <p>
              Align expectations on quantities, shipping arrangements,
              timelines, and applicable export requirements.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="process">
      <div class="container">
        <div class="section-heading">
          <div class="eyebrow">How We Work</div>
          <h2>A Clear Path to Trade Discussions.</h2>
          <p>
            Every transaction depends on product availability, agreed
            specifications, and the requirements of the destination market.
          </p>
        </div>

        <div class="process-grid">
          <article class="process-step">
            <span class="step-no">STEP 01</span>
            <h3>Initial Inquiry</h3>
            <p>Share the commodity, estimated quantity, and destination market.</p>
          </article>
          <article class="process-step">
            <span class="step-no">STEP 02</span>
            <h3>Product Discussion</h3>
            <p>Review specifications, packaging, availability, and documentation.</p>
          </article>
          <article class="process-step">
            <span class="step-no">STEP 03</span>
            <h3>Commercial Terms</h3>
            <p>Discuss pricing, payment conditions, and shipping terms where applicable.</p>
          </article>
          <article class="process-step">
            <span class="step-no">STEP 04</span>
            <h3>Order Coordination</h3>
            <p>Confirm responsibilities and next steps before any shipment proceeds.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="container">
        <div class="contact-box">
          <div>
            <div class="eyebrow">Start a Conversation</div>
            <h2>Let's Explore Your Next Commodity Opportunity.</h2>
            <p>
              Tell us which product you are interested in, your target
              quantity, and destination market. Our contact details can
              be updated here when your official business channels are ready.
            </p>
            <a class="btn btn-gold" href="mailto:YOUR_EMAIL@example.com?subject=Commodity%20Inquiry">
              Send an Email Inquiry ↗
            </a>
          </div>

          <div class="contact-details">
            <div class="contact-item">
              <span>Company</span>
              <strong>PT Ekspor Yuk</strong>
            </div>
            <div class="contact-item">
              <span>Commodity Focus</span>
              <strong>Fishmeal · Pellets · Coffee</strong>
            </div>
            <div class="contact-item">
              <span>Email</span>
              <a href="mailto:YOUR_EMAIL@example.com">YOUR_EMAIL@example.com</a>
            </div>
            <div class="contact-item">
              <span>Business Inquiries</span>
              <strong>Contact details to be updated</strong>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <p>© <span id="year"></span> PT Ekspor Yuk. All rights reserved.</p>
      <div class="footer-links">
        <a href="#home">Back to Top ↑</a>
        <a href="#products">Products</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById("menuToggle");
    const navLinks = document.getElementById("navLinks");

    menuToggle.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("open");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu"
      );
      menuToggle.textContent = isOpen ? "✕" : "☰";
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation menu");
        menuToggle.textContent = "☰";
      });
    });

    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>

</body>
</html>
